  levelTitle: Jalan Pasar
  chapterSubtitle: "CHAPTER 1  \u2022  TRANSLASI"
  districtLabel: JALAN PASAR LAMA
  parActions: 8
  requireFacingAngle: 0
  requiredFacingYaw: 0
  fragmentTitle: Gerai Roti Pagi
  triggerGlitchOnClear: 0

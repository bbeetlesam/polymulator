  m_Script: {fileID: 11500000, guid: 2763873eddf04f878f13270a059f332a, type: 3}
  m_Name: LevelShowcase
  m_EditorClassIdentifier: Assembly-CSharp::Polymulator.LevelInfo
  levelTitle: 'Ruang Showcase: Semua Mekanik'
  chapterSubtitle: "SPECIAL SHOWCASE  \u2022  SEMUA FITUR"
  districtLabel: SANDBOX & DEMO
  parActions: 8
  requireFacingAngle: 1
  requiredFacingYaw: 0
  fragmentTitle: Arsip Demo POLYMULATOR
  triggerGlitchOnClear: 0
  playPianoOnClear: 0
  allowPartition: 1
  allowFusion: 1
  openingDialogue:
  - speaker: TIM 8
    text: Selamat datang di Ruang Showcase! Semua mekanik siap diuji dengan pratinjau
      laser Partition & tautan Fusion.
  - speaker: RECT
    text: "Kiri: uji Partition [1] & sumbu potong [3]  \u2022  Kanan: uji Fusion
      [2] objek Kubus+Prisma  \u2022  Tengah: Rotasi [R] CORE-01."
  clearDialogue:
  - speaker: TIM 8
    text: Demo Showcase selesai! Semua sistem mekanik dan audio-visual terverifikasi
      berfungsi.
  hints:
  - 'KIRI (Partition [1] + [3]): Dekati DEMO-PARTITION (2.4 t) untuk melihat bidang
    potong laser oranye. Tekan [3] untuk mengganti sumbu potong, lalu [1] untuk membelah
    jadi 2 x 1.2 t.'
  - 'KANAN (Fusion Hibrid [2] + [TAB]/[F]): Dekatkan Kubus DEMO-FUSE-A & Prisma DEMO-FUSE-B,
    tekan [2] untuk menggabung dua bentuk berbeda jadi 2.4 t, lalu naikkan ke PAD-FUSE-ATAS.'
  - "TENGAH (Rotasi [R]): Ambil CORE-01, tekan [R] tiga kali sampai 0\xB0 (Utara),
    lalu pasang ke ANCHOR-01 di puncak."

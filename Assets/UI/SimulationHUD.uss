/* POLYMULATOR: Unified Architectural Simulation HUD & Modals (Catppuccin Mocha) */

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 28px 32px;
    flex-direction: column;
    justify-content: space-between;
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
}

.hud-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* Shared architectural surface card (Crust + 1px Overlay0 frame, 3px corner, zero decorative side stripes) */
.hud-card {
    background-color: rgba(17, 17, 27, 0.92);
    border-color: #6C7086;
    border-width: 1px;
    border-radius: 3px;
    flex-direction: column;
    overflow: hidden;
}

.card-top-rule {
    width: 100%;
    height: 3px;
    background-color: #94E2D5;
}

/* Top-Left Objective Card (Plate & Weight Status) */
.identity-card {
    min-width: 272px;
    max-width: 460px;
}

.identity-content {
    padding: 13px 20px 14px 20px;
    flex-direction: column;
    justify-content: center;
}

.objective-line {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 17px;
    color: #CDD6F4;
    letter-spacing: 0.2px;
}

.objective-detail-line {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    margin-top: 4px;
    white-space: normal;
}

/* Top-Center Status Toast (clean single bar, top rule only, no decorative dot) */
.status-toast {
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 24, 37, 0.96);
    border-color: #6C7086;
    border-width: 1px;
    border-top-width: 3px;
    border-top-color: #74C7EC;
    border-radius: 3px;
    padding: 10px 22px;
    margin-top: 2px;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}

.status-toast--hidden {
    opacity: 0;
    translate: 0 -8px;
}

.status-toast-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 16px;
    color: #CDD6F4;
}

/* Top-Right Contextual Object Card (Name + Weight + Rotation) */
.target-card {
    min-width: 210px;
    max-width: 320px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.target-card--hidden {
    opacity: 0;
    translate: 10px 0;
}

.target-content {
    padding: 12px 20px 14px 20px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
}

.target-name-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 20px;
    color: #CDD6F4;
    letter-spacing: 0.25px;
    margin-bottom: 3px;
    -unity-text-align: middle-right;
}

.target-metric-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.target-metric-icon {
    width: 16px;
    height: 16px;
    margin-left: 6px;
    color: #94E2D5;
}

.target-meta-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    white-space: normal;
    -unity-text-align: middle-right;
}

.target-rotation-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #BAC2DE;
    margin-top: 2px;
    white-space: normal;
    -unity-text-align: middle-right;
}

/* Bottom Row */
.hud-bottom-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.controls-card {
    width: 324px;
    transition-property: opacity;
    transition-duration: 0.16s;
}

.controls-card--collapsed {
    width: auto;
}

.controls-card--collapsed .controls-header-row {
    margin-bottom: 0;
}

.controls-card--collapsed .control-line {
    display: none;
}

.controls-content {
    padding: 12px 16px;
    flex-direction: column;
    flex-grow: 1;
}

.controls-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.controls-header {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 15px;
    color: #CDD6F4;
    margin-right: 12px;
}

.keycap-mini {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 13px;
    color: #11111B;
    background-color: #BAC2DE;
    border-radius: 2px;
    padding: 2px 8px;
}

.control-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.control-line--last {
    margin-bottom: 0;
}

.keycap {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    min-width: 92px;
    font-size: 13px;
    color: #CDD6F4;
    background-color: #313244;
    border-color: #7F849C;
    border-width: 1px;
    border-radius: 2px;
    padding: 3px 8px;
    margin-right: 12px;
    -unity-text-align: middle-center;
}

.control-desc {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #BAC2DE;
}

.bottom-center-stack {
    flex-direction: column;
    align-items: center;
}

/* Story Dialogue Card (reading order first, clean prompt bottom-right, no left stripe) */
.story-feed {
    flex-direction: column;
    min-width: 660px;
    max-width: 880px;
    background-color: rgba(24, 24, 37, 0.96);
    border-color: #6C7086;
    border-width: 1px;
    border-top-width: 3px;
    border-top-color: #74C7EC;
    border-radius: 3px;
    padding: 18px 24px 14px 24px;
    margin-bottom: 12px;
    transition-property: opacity, translate;
    transition-duration: 0.20s;
    transition-timing-function: ease-out-cubic;
}

.story-feed--hidden {
    opacity: 0;
    translate: 0 10px;
    display: none;
}

.story-text {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 22px;
    color: #CDD6F4;
    white-space: normal;
}

.story-footer-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 10px;
}

.story-progress {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #BAC2DE;
}

/* Interactive Fusing Stage Bar (shown only during side selection) */
.fusion-stage-bar {
    flex-direction: column;
    background-color: rgba(24, 24, 37, 0.96);
    border-color: #6C7086;
    border-width: 1px;
    border-radius: 3px;
    margin-bottom: 12px;
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 0.16s;
}

.fusion-stage-bar--hidden {
    display: none;
    opacity: 0;
    translate: 0 8px;
}

.fusion-stage-content {
    flex-direction: column;
    padding: 11px 22px 12px 22px;
    align-items: center;
}

.fusion-stage-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 17px;
    color: #A6E3A1;
    letter-spacing: 0.3px;
    margin-bottom: 3px;
}

.fusion-stage-hint {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #BAC2DE;
}

/* 6-Slot Ability Dock (restrained palette: neutral standard slots, focused mode/context accent) */
.ability-dock {
    flex-direction: row;
    align-items: center;
    background-color: rgba(17, 17, 27, 0.92);
    border-color: #6C7086;
    border-width: 1px;
    border-radius: 3px;
    padding: 8px 10px;
}

.ability-slot {
    min-width: 112px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(24, 24, 37, 0.72);
    border-color: #45475A;
    border-width: 1px;
    border-radius: 3px;
    padding: 9px 12px;
    margin-right: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
}

.ability-slot--active {
    border-color: #585B70;
}

.ability-slot--highlight {
    background-color: rgba(116, 199, 236, 0.16);
    border-color: #74C7EC;
}

.ability-slot--flexible {
    background-color: rgba(203, 166, 247, 0.16);
    border-color: #CBA6F7;
}

.ability-slot--partition-ready {
    background-color: rgba(250, 179, 135, 0.14);
    border-color: #FAB387;
}

.ability-slot--fusion-ready {
    background-color: rgba(166, 227, 161, 0.18);
    border-color: #A6E3A1;
}

.ability-slot--queued {
    background-color: rgba(17, 17, 27, 0.65);
    border-color: #313244;
    opacity: 0.58;
}

.ability-slot--last {
    margin-right: 0;
}

.dock-divider {
    width: 1px;
    height: 40px;
    background-color: #585B70;
    margin-right: 8px;
}

.ability-icon {
    width: 26px;
    height: 26px;
    margin-bottom: 6px;
    color: #CDD6F4;
}

.ability-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #CDD6F4;
    margin-bottom: 0;
}

.bottom-right-spacer {
    width: 324px;
}

/* Modal Overlay (Unified with Main Menu architectural modal system) */
.chamber-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(17, 17, 27, 0.82);
    transition-property: opacity;
    transition-duration: 0.18s;
}

.chamber-overlay--hidden {
    display: none;
    opacity: 0;
}

.modal-card {
    width: 540px;
    background-color: #1E1E2E;
    border-color: #7F849C;
    border-width: 1px;
    border-radius: 3px;
    padding: 32px 34px 28px 34px;
    align-items: stretch;
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.modal-card--entering {
    opacity: 0;
    translate: 0 8px;
}

.modal-card--ending {
    width: 680px;
    padding: 34px 36px 28px 36px;
}

.modal-top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background-color: #74C7EC;
}

.modal-subtitle {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #94E2D5;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.modal-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 28px;
    color: #CDD6F4;
    margin-bottom: 14px;
    -unity-text-align: middle-left;
}

.modal-rank {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.modal-rank-star {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.modal-rank-tag {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 14px;
    color: #F9E2AF;
    margin-left: 8px;
}

.modal-rank--hidden {
    display: none;
}

.modal-metrics {
    width: 100%;
    flex-direction: column;
    background-color: #181825;
    border-color: #45475A;
    border-width: 1px;
    border-radius: 3px;
    padding: 14px 16px;
    margin-bottom: 20px;
}

.modal-metrics--hidden {
    display: none;
}

.modal-metric-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.modal-metric-cell {
    flex-grow: 1;
    align-items: center;
    border-right-color: #45475A;
    border-right-width: 1px;
    padding: 2px 8px;
}

.modal-metric-cell--last {
    border-right-width: 0;
}

.metric-value {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 24px;
    color: #A6E3A1;
}

.metric-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 13px;
    color: #BAC2DE;
    margin-top: 2px;
}

.metric-concept-note {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #BAC2DE;
    -unity-text-align: middle-left;
    white-space: normal;
    border-top-color: #313244;
    border-top-width: 1px;
    padding-top: 10px;
}

.ending-epilogue-box {
    width: 100%;
    flex-direction: column;
    background-color: #181825;
    border-color: #45475A;
    border-width: 1px;
    border-radius: 3px;
    padding: 18px 20px;
    margin-bottom: 20px;
}

.ending-epilogue-box--hidden {
    display: none;
}

.ending-summary {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 16px;
    color: #94E2D5;
    white-space: normal;
    margin-bottom: 12px;
}

.ending-epilogue-para {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 15px;
    color: #CDD6F4;
    white-space: normal;
    margin-bottom: 10px;
}

.ending-memories-tag {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #F2CDCD;
    margin-top: 4px;
}

.pause-settings-panel {
    width: 100%;
    flex-direction: column;
    background-color: #181825;
    border-color: #45475A;
    border-width: 1px;
    border-radius: 3px;
    padding: 14px 18px;
    margin-bottom: 18px;
}

.pause-settings-panel--hidden {
    display: none;
}

.pause-setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.pause-setting-row--last {
    margin-bottom: 0;
}

.pause-setting-label-group {
    flex-direction: row;
    align-items: center;
    width: 200px;
}

.pause-setting-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    color: #BAC2DE;
}

.pause-setting-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #CDD6F4;
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.pause-setting-slider {
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 12px;
}

.pause-setting-slider .unity-base-slider__tracker {
    background-color: #6C7086;
    height: 6px;
    border-radius: 3px;
}

.pause-setting-slider .unity-base-slider__dragger {
    background-color: #74C7EC;
    border-color: #CDD6F4;
    border-width: 2px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-top: -6px;
}

.pause-setting-slider:focus .unity-base-slider__dragger {
    background-color: #89DCEB;
    border-color: #F9E2AF;
}

.pause-setting-value {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    min-width: 52px;
    -unity-text-align: middle-right;
}

.pause-setting-toggle {
    margin: 0;
}

.pause-setting-toggle .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    background-color: #313244;
    border-color: #7F849C;
    border-width: 2px;
    border-radius: 3px;
    -unity-background-image-tint-color: #11111B;
}

.pause-setting-toggle:focus .unity-toggle__checkmark {
    border-color: #F9E2AF;
}

.pause-setting-toggle:checked .unity-toggle__checkmark {
    background-color: #74C7EC;
    border-color: #89B4FA;
    -unity-background-image-tint-color: #11111B;
}

.modal-actions {
    width: 100%;
    flex-direction: column;
}

/* Modal buttons matching Main Menu: 1 solid primary CTA + flat clean secondary rows */
.modal-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    width: 100%;
    height: 48px;
    font-size: 16px;
    color: #CDD6F4;
    background-color: #181825;
    border-color: #6C7086;
    border-width: 1px;
    border-radius: 3px;
    padding: 0 20px;
    margin-bottom: 10px;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
}

.modal-btn:hover {
    background-color: #313244;
    border-color: #74C7EC;
    color: #CDD6F4;
}

.modal-btn:focus {
    background-color: #313244;
    border-color: #F9E2AF;
    border-width: 2px;
    color: #CDD6F4;
}

.modal-btn:active {
    background-color: #45475A;
}

.modal-btn--primary {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    height: 54px;
    font-size: 18px;
    color: #11111B;
    background-color: #74C7EC;
    border-color: #74C7EC;
    border-width: 2px;
    margin-bottom: 14px;
}

.modal-btn--primary:hover {
    background-color: #89DCEB;
    border-color: #89DCEB;
    color: #11111B;
}

.modal-btn--primary:focus {
    background-color: #89DCEB;
    border-color: #F9E2AF;
    border-width: 3px;
    color: #11111B;
}

.modal-btn--subtle {
    background-color: transparent;
    border-color: #6C7086;
    color: #BAC2DE;
    margin-bottom: 0;
}

.modal-btn--subtle:hover {
    background-color: #313244;
    border-color: #7F849C;
    color: #CDD6F4;
}

.modal-btn--subtle:focus {
    background-color: #313244;
    border-color: #F9E2AF;
    border-width: 2px;
    color: #CDD6F4;
}

.modal-btn--hidden {
    display: none;
}

/* Reduced motion override toggled by SimulationSettings.ReduceMotion */
.hud-root--reduce-motion .status-toast,
.hud-root--reduce-motion .target-card,
.hud-root--reduce-motion .controls-card,
.hud-root--reduce-motion .story-feed,
.hud-root--reduce-motion .fusion-stage-bar,
.hud-root--reduce-motion .ability-slot,
.hud-root--reduce-motion .chamber-overlay,
.hud-root--reduce-motion .modal-card,
.hud-root--reduce-motion .modal-btn {
    transition-duration: 0s;
}

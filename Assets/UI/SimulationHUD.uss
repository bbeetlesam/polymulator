/* POLYMULATOR — Catppuccin Mocha HUD Stylesheet */

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px;
    flex-direction: column;
    justify-content: space-between;
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
}

.hud-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.panel-card {
    background-color: rgba(17, 17, 27, 0.92);
    border-color: #45475A;
    border-width: 1px;
    border-radius: 2px;
    flex-direction: row;
}

.accent-bar {
    width: 4px;
    background-color: #74C7EC;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

.accent-bar--right {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: #74C7EC;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* Identity Card */
.identity-card {
    min-width: 344px;
}

.identity-content {
    padding: 12px 16px 12px 14px;
    flex-direction: column;
}

.brand-subtitle {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 15px;
    color: #CDD6F4;
    letter-spacing: 0.35px;
    margin-bottom: 9px;
}

.mode-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(49, 50, 68, 0.80);
    border-color: #585B70;
    border-width: 1px;
    border-radius: 2px;
    padding: 7px 11px;
}

.mode-icon {
    width: 24px;
    height: 24px;
    margin-right: 11px;
    color: #74C7EC;
}

.mode-pill-text {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 14px;
}

.mode-badge-title {
    font-size: 16px;
    color: #74C7EC;
    letter-spacing: 1px;
}

.mode-badge-sub {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #BAC2DE;
}

.keycap-mini {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 13px;
    color: #11111B;
    background-color: #BAC2DE;
    border-radius: 2px;
    padding: 3px 8px;
}

.objective-line {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    margin-top: 10px;
    letter-spacing: 0.4px;
}

/* Toast */
.status-toast {
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 24, 37, 0.95);
    border-color: #74C7EC;
    border-width: 1px;
    border-radius: 2px;
    padding: 8px 18px;
    margin-top: 4px;
    transition-property: opacity, translate;
    transition-duration: 0.2s;
}

.status-toast--hidden {
    opacity: 0;
    translate: 0 -8px;
}

.toast-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: #74C7EC;
    margin-right: 10px;
}

.status-toast-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #CDD6F4;
}

/* Contextual Target Card */
.target-card {
    min-width: 310px;
    max-width: 440px;
    transition-property: opacity, translate;
    transition-duration: 0.16s;
}

.target-card--hidden {
    opacity: 0;
    translate: 10px 0;
}

.target-content {
    padding: 12px 24px 12px 15px;
    flex-direction: column;
    flex-grow: 1;
}

.target-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.target-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background-color: #585B70;
    margin-right: 9px;
}

.target-state-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 13px;
    color: #A6ADC8;
}

.target-name-label {
    font-size: 22px;
    color: #CDD6F4;
    margin-bottom: 3px;
}

.target-meta-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #BAC2DE;
    white-space: normal;
}

.target-vector-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 13px;
    color: #94E2D5;
    margin-top: 4px;
    white-space: normal;
}

/* Bottom Row */
.hud-bottom-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.controls-card {
    width: 304px;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.controls-card--collapsed {
    width: auto;
    opacity: 0.82;
}

.controls-card--collapsed .controls-header-row {
    margin-bottom: 0;
}

.controls-card--collapsed .control-line {
    display: none;
}

.controls-accent-bar {
    background-color: #585B70;
}

.controls-content {
    padding: 11px 14px;
    flex-direction: column;
    flex-grow: 1;
}

.controls-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.controls-header {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 13px;
    color: #BAC2DE;
    letter-spacing: 0.5px;
    margin-right: 10px;
}

.control-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.control-line--last {
    margin-bottom: 0;
}

.keycap {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    min-width: 84px;
    font-size: 12px;
    color: #CDD6F4;
    background-color: #313244;
    border-color: #585B70;
    border-width: 1px;
    border-radius: 2px;
    padding: 3px 7px;
    margin-right: 10px;
    -unity-text-align: middle-center;
}

.control-desc {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #CDD6F4;
}

.bottom-center-stack {
    flex-direction: column;
    align-items: center;
}

.story-feed {
    flex-direction: column;
    min-width: 520px;
    max-width: 760px;
    background-color: rgba(24, 24, 37, 0.92);
    border-color: rgba(69, 71, 90, 0.72);
    border-width: 1px;
    border-left-width: 3px;
    border-left-color: #74C7EC;
    border-radius: 2px;
    padding: 13px 18px 14px 18px;
    margin-bottom: 10px;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.story-feed--hidden {
    opacity: 0;
    translate: 0 12px;
    display: none;
}

.story-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.story-speaker {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 13px;
    color: #74C7EC;
    letter-spacing: 0.6px;
}

.story-progress {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 12px;
    color: #9399B2;
    letter-spacing: 0.4px;
}

.story-text {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 17px;
    color: #CDD6F4;
    white-space: normal;
    letter-spacing: 0.1px;
}

.context-prompt {
    flex-direction: row;
    align-items: center;
    background-color: rgba(24, 24, 37, 0.88);
    border-color: rgba(69, 71, 90, 0.72);
    border-width: 1px;
    border-radius: 2px;
    margin-bottom: 8px;
    padding-right: 16px;
    height: 38px;
    transition-property: opacity, translate;
    transition-duration: 0.14s;
}

.context-prompt--hidden {
    opacity: 0;
    translate: 0 6px;
}

.context-prompt-accent {
    width: 3px;
    height: 100%;
    background-color: #74C7EC;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    margin-right: 12px;
}

.context-prompt-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #CDD6F4;
}

.ability-dock {
    flex-direction: row;
    align-items: center;
    background-color: rgba(17, 17, 27, 0.88);
    border-color: rgba(69, 71, 90, 0.65);
    border-width: 1px;
    border-radius: 2px;
    padding: 7px 9px;
}

.ability-slot {
    min-width: 118px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(49, 50, 68, 0.45);
    border-color: rgba(69, 71, 90, 0.60);
    border-width: 1px;
    border-radius: 2px;
    padding: 7px 7px;
    margin-right: 7px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.ability-slot--active {
    border-color: rgba(88, 91, 112, 0.85);
}

.ability-slot--highlight {
    background-color: rgba(116, 199, 236, 0.14);
    border-color: rgba(116, 199, 236, 0.72);
}

.ability-slot--flexible {
    background-color: rgba(203, 166, 247, 0.14);
    border-color: rgba(203, 166, 247, 0.72);
}

.ability-slot--partition-ready {
    background-color: rgba(250, 179, 135, 0.14);
    border-color: rgba(250, 179, 135, 0.78);
}

.ability-slot--fusion-ready {
    background-color: rgba(166, 227, 161, 0.16);
    border-color: rgba(166, 227, 161, 0.82);
}

.ability-slot--queued {
    background-color: rgba(24, 24, 37, 0.55);
    border-color: rgba(49, 50, 68, 0.65);
    opacity: 0.52;
}

.ability-slot--last {
    margin-right: 0;
}

.dock-divider {
    width: 1px;
    height: 48px;
    background-color: #45475A;
    margin-right: 7px;
}

.ability-icon {
    width: 26px;
    height: 26px;
    margin-bottom: 5px;
    color: #CDD6F4;
}

.ability-title {
    font-size: 13px;
    color: #CDD6F4;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.ability-key {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 12px;
    color: #BAC2DE;
}

.bottom-right-spacer {
    width: 304px;
}

/* Modal Overlay (Pause / Chamber Clear / Settings) */
.chamber-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(17, 17, 27, 0.78);
    transition-property: opacity;
    transition-duration: 0.18s;
}

.chamber-overlay--hidden {
    display: none;
    opacity: 0;
}

.modal-card {
    width: 492px;
    background-color: #1E1E2E;
    border-color: #585B70;
    border-width: 1px;
    border-radius: 3px;
    padding: 28px 30px 24px 30px;
    align-items: center;
    transition-property: scale, opacity, translate;
    transition-duration: 0.20s;
    transition-timing-function: ease-out-cubic;
}

.modal-card--entering {
    opacity: 0;
    scale: 0.94 0.94;
    translate: 0 10px;
}

.modal-top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background-color: #74C7EC;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

.modal-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 24px;
    color: #CDD6F4;
    letter-spacing: 0.4px;
    margin-top: 4px;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

.modal-subtitle {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 14px;
    color: #BAC2DE;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.modal-rank {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 17px;
    color: #F9E2AF;
    letter-spacing: 1px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.modal-rank--hidden {
    display: none;
}

.modal-actions {
    width: 100%;
    flex-direction: column;
}

.modal-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 16px;
    letter-spacing: 1px;
    color: #CDD6F4;
    background-color: #313244;
    border-color: #585B70;
    border-width: 1px;
    border-left-width: 4px;
    border-radius: 2px;
    height: 48px;
    margin-bottom: 10px;
    transition-property: background-color, border-color, color, scale, translate;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-cubic;
}

.modal-btn:hover {
    background-color: #45475A;
    border-color: #89B4FA;
    scale: 1.02 1.02;
    translate: 0 -1px;
}

.modal-btn:focus {
    background-color: #45475A;
    border-color: #74C7EC;
    color: #74C7EC;
}

.modal-btn:active {
    scale: 0.97 0.97;
    translate: 0 1px;
}

.modal-btn--primary {
    border-left-color: #74C7EC;
    border-color: #74C7EC;
    color: #74C7EC;
}

.modal-btn--primary:hover {
    background-color: rgba(116, 199, 236, 0.18);
    color: #CDD6F4;
}

.modal-btn--hidden {
    display: none;
}

.pause-settings-panel {
    width: 100%;
    flex-direction: column;
    background-color: rgba(24, 24, 37, 0.90);
    border-color: #45475A;
    border-width: 1px;
    border-radius: 2px;
    padding: 12px 14px;
    margin-bottom: 14px;
}

.pause-settings-panel--hidden {
    display: none;
}

.pause-setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.pause-setting-row--last {
    margin-bottom: 0;
}

.pause-setting-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 13px;
    color: #CDD6F4;
    min-width: 150px;
}

.pause-setting-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 10px;
}

.pause-setting-slider .unity-base-slider__tracker {
    background-color: #45475A;
    height: 6px;
    border-radius: 3px;
}

.pause-setting-slider .unity-base-slider__dragger {
    background-color: #74C7EC;
    border-color: #CDD6F4;
    border-width: 2px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-top: -5px;
}

.pause-setting-value {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 13px;
    color: #94E2D5;
    min-width: 44px;
    -unity-text-align: middle-right;
}

.pause-setting-toggle {
    margin: 0;
}

.pause-setting-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    background-color: #313244;
    border-color: #585B70;
    border-width: 1px;
    border-radius: 2px;
    -unity-background-image-tint-color: #11111B;
}

.pause-setting-toggle:checked .unity-toggle__checkmark {
    background-color: #74C7EC;
    border-color: #89B4FA;
    -unity-background-image-tint-color: #11111B;
}

.modal-metrics {
    width: 100%;
    flex-direction: column;
    background-color: rgba(24, 24, 37, 0.85);
    border-color: #45475A;
    border-width: 1px;
    border-radius: 2px;
    padding: 12px 14px;
    margin-bottom: 16px;
}

.modal-metrics--hidden {
    display: none;
}

.modal-metric-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.modal-metric-cell {
    flex-grow: 1;
    align-items: center;
    border-right-color: #45475A;
    border-right-width: 1px;
    padding: 2px 6px;
}

.modal-metric-cell--last {
    border-right-width: 0;
}

.metric-value {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 22px;
    color: #A6E3A1;
}

.metric-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 11px;
    color: #BAC2DE;
    margin-top: 2px;
}

.modal-card--ending {
    width: 640px;
    padding: 28px 32px 24px 32px;
}

.ending-epilogue-box {
    width: 100%;
    flex-direction: column;
    background-color: rgba(24, 24, 37, 0.88);
    border-color: rgba(69, 71, 90, 0.72);
    border-width: 1px;
    border-radius: 2px;
    padding: 14px 18px;
    margin-bottom: 14px;
}

.ending-epilogue-box--hidden {
    display: none;
}

.ending-summary {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    font-size: 15px;
    color: #94E2D5;
    white-space: normal;
    margin-bottom: 10px;
}

.ending-epilogue-para {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #CDD6F4;
    white-space: normal;
    margin-bottom: 8px;
}

.ending-memories-tag {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 12px;
    color: #F2CDCD;
    margin-top: 4px;
}

.metric-concept-note {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #94E2D5;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-left: 4px;
    margin-right: 4px;
    border-top-color: #313244;
    border-top-width: 1px;
    padding-top: 8px;
}

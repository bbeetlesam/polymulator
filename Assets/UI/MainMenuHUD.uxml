<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainMenuHUD.uss" />
    <ui:VisualElement name="menu-root" class="menu-root">

        <!-- Title View: Architectural Left Rail + Unobstructed Right 3D Stage -->
        <ui:VisualElement name="title-view" class="title-view">
            <ui:VisualElement class="title-rail">
                <ui:VisualElement class="brand-block" picking-mode="Ignore">
                    <ui:VisualElement class="brand-kicker" picking-mode="Ignore">
                        <ui:VisualElement class="brand-mark-a" picking-mode="Ignore" />
                        <ui:VisualElement class="brand-mark-b" picking-mode="Ignore" />
                        <ui:Label name="title-iter-label" text="KOTA TEPI  /  ARSIP SPASIAL" class="brand-kicker-text" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:Label text="POLYMULATOR" class="hero-title" picking-mode="Ignore" />
                    <ui:Label text="Rekonstruksi ruang melalui translasi, rotasi, partisi, dan fusi." class="hero-tagline" picking-mode="Ignore" />
                    <ui:VisualElement class="rail-divider" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="title-buttons" class="title-buttons">
                    <ui:Button name="btn-enter" text="Mulai Simulasi" class="primary-cta-btn" />
                    <ui:Button name="btn-chapters" text="Pilih Ruangan" class="nav-row-btn" />
                    <ui:Button name="btn-title-showcase" text="Ruang Showcase" class="nav-row-btn" />
                    <ui:Button name="btn-title-settings" text="Pengaturan" class="nav-row-btn" />
                    <ui:VisualElement class="nav-divider" picking-mode="Ignore" />
                    <ui:Button name="btn-shutdown" text="Keluar" class="nav-row-btn nav-row-btn--quit" />
                </ui:VisualElement>

                <ui:VisualElement class="rail-footer" picking-mode="Ignore">
                    <ui:Label name="title-progress-label" text="0/14 Ruangan Selesai  •  0 Memori" class="footer-progress" picking-mode="Ignore" />
                    <ui:Label text="Panah / W-S: Pilih   •   Enter: Buka" class="footer-hint" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="stage-spacer" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Chapter & Chamber Index View -->
        <ui:VisualElement name="ribbon-view" class="ribbon-view ribbon-view--hidden">
            <ui:VisualElement class="ribbon-topbar">
                <ui:VisualElement class="topbar-left">
                    <ui:Button name="btn-ribbon-back" text="[Esc] Beranda" class="top-action-btn" />
                    <ui:Label name="ribbon-meta-label" text="0/14 Ruangan  •  0 Memori" class="topbar-progress" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="topbar-actions">
                    <ui:Button name="btn-ribbon-showcase" text="Ruang Showcase" class="top-action-btn" />
                    <ui:Button name="btn-demo-toggle" text="[F2] Buka Semua: Mati" class="top-action-btn" />
                    <ui:Button name="btn-ribbon-settings" text="Pengaturan" class="top-action-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ribbon-viewport" class="ribbon-viewport">
                <ui:VisualElement name="ribbon-track" class="ribbon-track" />
            </ui:VisualElement>

            <ui:VisualElement class="ribbon-footer">
                <ui:VisualElement name="chamber-preview-card" class="chamber-preview-card">
                    <ui:VisualElement class="preview-content" picking-mode="Ignore">
                        <ui:Label name="preview-chapter-label" text="Chapter 1  •  Translasi" class="preview-chapter" picking-mode="Ignore" />
                        <ui:Label name="preview-title-label" text="1.1  •  Bangun di Ruangan Kosong" class="preview-title" picking-mode="Ignore" />
                        <ui:Label name="preview-status-label" text="Siap dimulai  •  Klik titik level atau tekan Enter" class="preview-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="btn-preview-launch" text="Mulai" class="preview-launch-btn" />
                </ui:VisualElement>
                <ui:Label text="Geser / Scroll / A-D: Telusuri Chapter   •   Klik titik ruangan atau tekan Enter untuk masuk" class="footer-hint footer-hint--center" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Settings Modal -->
        <ui:VisualElement name="settings-overlay" class="settings-overlay settings-overlay--hidden">
            <ui:VisualElement name="settings-card" class="settings-card">
                <ui:Label text="Pengaturan" class="settings-title" picking-mode="Ignore" />
                <ui:Label text="Audio, sensitivitas kamera, dan kenyamanan gerak" class="settings-subtitle" picking-mode="Ignore" />

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Volume Utama" class="setting-label" picking-mode="Ignore" />
                    <ui:Slider name="slider-volume" low-value="0" high-value="100" value="85" class="setting-slider" />
                    <ui:Label name="val-volume" text="85%" class="setting-value" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Sensitivitas Kamera" class="setting-label" picking-mode="Ignore" />
                    <ui:Slider name="slider-sensitivity" low-value="40" high-value="220" value="100" class="setting-slider" />
                    <ui:Label name="val-sensitivity" text="1.0x" class="setting-value" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Kurangi Gerak" class="setting-label" picking-mode="Ignore" />
                    <ui:Toggle name="toggle-reduce-motion" class="setting-toggle" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-actions">
                    <ui:Button name="btn-reset-save" text="Reset Progres" class="modal-btn modal-btn--danger" />
                    <ui:Button name="btn-settings-close" text="Selesai  [Esc]" class="modal-btn modal-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

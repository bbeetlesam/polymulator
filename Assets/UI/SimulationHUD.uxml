<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:poly="Polymulator" editor-extension-mode="False">
    <Style src="SimulationHUD.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">

        <!-- Top Row: Objective Status | Toast | Contextual Object Card -->
        <ui:VisualElement name="hud-top-row" class="hud-top-row" picking-mode="Ignore">
            <ui:VisualElement name="identity-card" class="hud-card identity-card" picking-mode="Ignore">
                <ui:VisualElement name="mode-accent-bar" class="card-top-rule" picking-mode="Ignore" />
                <ui:VisualElement class="identity-content" picking-mode="Ignore">
                    <ui:Label name="objective-label" text="" class="objective-line" picking-mode="Ignore" />
                    <ui:Label name="objective-detail-label" text="" class="objective-detail-line" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="status-toast" class="status-toast status-toast--hidden" picking-mode="Ignore">
                <ui:Label name="status-toast-label" text="" class="status-toast-label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="target-card" class="hud-card target-card target-card--hidden" picking-mode="Ignore">
                <ui:VisualElement name="target-accent-bar" class="card-top-rule" picking-mode="Ignore" />
                <ui:VisualElement class="target-content" picking-mode="Ignore">
                    <ui:Label name="target-name-label" text="" class="target-name-label" picking-mode="Ignore" />
                    <ui:Label name="target-meta-label" text="" class="target-meta-label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Row: Collapsible Controls | Story + Fusing Stage + Ability Dock | Spacer -->
        <ui:VisualElement name="hud-bottom-row" class="hud-bottom-row" picking-mode="Ignore">
            <ui:VisualElement name="controls-card" class="hud-card controls-card" picking-mode="Ignore">
                <ui:VisualElement class="controls-content" picking-mode="Ignore">
                    <ui:VisualElement class="controls-header-row" picking-mode="Ignore">
                        <poly:LocalizedText loc-key="ui.hud.controls.title" class="loc-text controls-header" picking-mode="Ignore" />
                        <ui:Label text="H" class="keycap-mini" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="WASD" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.move" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="TAB" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.switch_mode" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="E / LMB" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.pickup" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="R / F" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.rotate_throw" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="Q / Z / SCR" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.distance_height" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="1 / 3 / 2" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.abilities" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="RMB / C" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.camera" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line" picking-mode="Ignore">
                        <ui:Label text="V / F1" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.axis_hints" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="control-line control-line--last" picking-mode="Ignore">
                        <ui:Label text="ESC" class="keycap" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.controls.pause" class="loc-text control-desc" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="bottom-center-stack" picking-mode="Ignore">
                <ui:VisualElement name="story-feed" class="story-feed story-feed--hidden">
                    <ui:Label name="story-text-label" text="" class="story-text" picking-mode="Ignore" />
                    <ui:VisualElement class="story-footer-row" picking-mode="Ignore">
                        <ui:Label name="story-progress-label" text="" class="story-progress" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="fusion-stage-bar" class="fusion-stage-bar fusion-stage-bar--hidden" picking-mode="Ignore">
                    <ui:VisualElement name="fusion-stage-accent" class="card-top-rule" picking-mode="Ignore" />
                    <ui:VisualElement class="fusion-stage-content" picking-mode="Ignore">
                        <ui:Label name="fusion-stage-title" text="" class="fusion-stage-title" picking-mode="Ignore" />
                        <ui:Label name="fusion-stage-hint" text="" class="fusion-stage-hint" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="ability-dock" class="ability-dock" picking-mode="Ignore">
                    <ui:VisualElement name="slot-translasi" class="ability-slot ability-slot--active" picking-mode="Ignore">
                        <poly:HudVectorIcon name="icon-translasi" icon-kind="Translasi" class="ability-icon" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.ability.translation" class="loc-text ability-title" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="slot-elevasi" class="ability-slot ability-slot--active" picking-mode="Ignore">
                        <poly:HudVectorIcon name="icon-elevasi" icon-kind="Elevasi" class="ability-icon" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.ability.elevation" class="loc-text ability-title" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="slot-rotasi" class="ability-slot ability-slot--active" picking-mode="Ignore">
                        <poly:HudVectorIcon name="icon-rotasi" icon-kind="Rotasi" class="ability-icon" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.ability.rotation" class="loc-text ability-title" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="slot-special" class="ability-slot ability-slot--highlight" picking-mode="Ignore">
                        <poly:HudVectorIcon name="icon-special" icon-kind="Throw" class="ability-icon" picking-mode="Ignore" />
                        <ui:Label name="title-special" text="" class="ability-title" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="dock-divider" picking-mode="Ignore" />

                    <ui:VisualElement name="slot-partition" class="ability-slot ability-slot--queued" picking-mode="Ignore">
                        <poly:HudVectorIcon name="icon-partition" icon-kind="Partition" class="ability-icon" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.ability.partition" class="loc-text ability-title" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="slot-fusion" class="ability-slot ability-slot--queued ability-slot--last" picking-mode="Ignore">
                        <poly:HudVectorIcon name="icon-fusion" icon-kind="Fusion" class="ability-icon" picking-mode="Ignore" />
                        <poly:LocalizedText loc-key="ui.hud.ability.fusion" class="loc-text ability-title" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="bottom-right-spacer" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Modal Overlay: Pause, Chamber Clear, Settings, Ending Epilogue -->
        <ui:VisualElement name="chamber-overlay" class="chamber-overlay chamber-overlay--hidden">
            <ui:VisualElement name="modal-card" class="modal-card">
                <ui:VisualElement name="modal-accent-bar" class="modal-top-bar" picking-mode="Ignore" />
                <ui:Label name="modal-subtitle" text="" class="modal-subtitle" picking-mode="Ignore" />
                <ui:Label name="modal-title" text="" class="modal-title" picking-mode="Ignore" />
                <ui:Label name="modal-rank-label" text="" class="modal-rank modal-rank--hidden" picking-mode="Ignore" />

                <ui:VisualElement name="ending-epilogue-box" class="ending-epilogue-box ending-epilogue-box--hidden">
                    <ui:Label name="ending-summary-label" text="" class="ending-summary" />
                    <ui:Label name="ending-epilogue-p1" text="" class="ending-epilogue-para" />
                    <ui:Label name="ending-epilogue-p2" text="" class="ending-epilogue-para" />
                    <ui:Label name="ending-epilogue-p3" text="" class="ending-epilogue-para" />
                    <ui:Label name="ending-memories-label" text="" class="ending-memories-tag" />
                </ui:VisualElement>

                <ui:VisualElement name="modal-metrics" class="modal-metrics modal-metrics--hidden">
                    <ui:VisualElement class="modal-metric-row">
                        <ui:VisualElement class="modal-metric-cell">
                            <ui:Label name="metric-translations" text="" class="metric-value" />
                            <poly:LocalizedText loc-key="ui.hud.ability.translation" class="loc-text metric-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="modal-metric-cell">
                            <ui:Label name="metric-rotations" text="" class="metric-value" />
                            <poly:LocalizedText loc-key="ui.hud.ability.rotation" class="loc-text metric-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="modal-metric-cell modal-metric-cell--last">
                            <ui:Label name="metric-tethers" text="" class="metric-value" />
                            <poly:LocalizedText loc-key="ui.hud.metrics.throw_tether" class="loc-text metric-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <poly:LocalizedText loc-key="ui.hud.metrics.concept_note" class="loc-text metric-concept-note" />
                </ui:VisualElement>

                <ui:VisualElement name="pause-settings-panel" class="pause-settings-panel pause-settings-panel--hidden">
                    <ui:VisualElement class="pause-setting-row">
                        <poly:LocalizedText loc-key="ui.menu.settings.volume" class="loc-text pause-setting-label" picking-mode="Ignore" />
                        <ui:Slider name="pause-slider-volume" low-value="0" high-value="100" value="85" class="pause-setting-slider" />
                        <ui:Label name="pause-val-volume" text="" class="pause-setting-value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pause-setting-row">
                        <poly:LocalizedText loc-key="ui.menu.settings.sensitivity" class="loc-text pause-setting-label" picking-mode="Ignore" />
                        <ui:Slider name="pause-slider-sensitivity" low-value="40" high-value="220" value="100" class="pause-setting-slider" />
                        <ui:Label name="pause-val-sensitivity" text="" class="pause-setting-value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pause-setting-row pause-setting-row--last">
                        <poly:LocalizedText loc-key="ui.menu.settings.reduce_motion" class="loc-text pause-setting-label" picking-mode="Ignore" />
                        <ui:Toggle name="pause-toggle-reduce" class="pause-setting-toggle" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="modal-actions">
                    <ui:Button name="btn-next" text="" class="modal-btn modal-btn--primary modal-btn--hidden" />
                    <ui:Button name="btn-resume" text="" class="modal-btn modal-btn--primary" />
                    <ui:Button name="btn-pause-settings" text="" class="modal-btn" />
                    <ui:Button name="btn-replay" text="" class="modal-btn" />
                    <ui:Button name="btn-mainmenu" text="" class="modal-btn modal-btn--subtle" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

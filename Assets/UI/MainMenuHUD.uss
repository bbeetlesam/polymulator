/* POLYMULATOR: Main Menu & Chapter Index (Catppuccin Mocha) */

.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
}

/* Title View: Architectural Left Rail + Open 3D Stage */
.title-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: stretch;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.title-view--hidden {
    opacity: 0;
    translate: -24px 0;
    display: none;
}

.title-rail {
    width: 580px;
    height: 100%;
    background-color: rgba(17, 17, 27, 0.94);
    border-right-width: 1px;
    border-right-color: #6C7086;
    padding: 72px 56px 52px 64px;
    flex-direction: column;
    justify-content: space-between;
}

.stage-spacer {
    flex-grow: 1;
}

.brand-block {
    flex-direction: column;
    align-items: flex-start;
}

.brand-kicker {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

/* Two-part geometric motif referencing Partition and Fusion */
.brand-mark-a {
    width: 10px;
    height: 10px;
    background-color: #74C7EC;
    border-radius: 1px;
    margin-right: 4px;
}

.brand-mark-b {
    width: 10px;
    height: 10px;
    background-color: #94E2D5;
    border-radius: 1px;
    margin-right: 12px;
}

.brand-kicker-text {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    letter-spacing: 1.8px;
}

.hero-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 66px;
    color: #CDD6F4;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    margin-left: -2px;
    -unity-text-align: middle-left;
}

.hero-tagline {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 18px;
    color: #BAC2DE;
    white-space: normal;
    -unity-text-align: upper-left;
}

.rail-divider {
    width: 100%;
    height: 1px;
    background-color: #45475A;
    margin-top: 30px;
}

.title-buttons {
    width: 100%;
    flex-direction: column;
    margin-top: 8px;
    margin-bottom: 8px;
}

/* Single solid focal primary CTA (Crust on Sapphire: 9.93:1 WCAG AAA) */
.primary-cta-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    width: 100%;
    height: 60px;
    font-size: 20px;
    letter-spacing: 0.4px;
    color: #11111B;
    background-color: #74C7EC;
    border-width: 2px;
    border-color: #74C7EC;
    border-radius: 3px;
    padding: 0 22px;
    margin-bottom: 18px;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-cubic;
}

.primary-cta-btn:hover {
    background-color: #89DCEB;
    border-color: #89DCEB;
}

.primary-cta-btn:focus {
    background-color: #89DCEB;
    border-color: #F9E2AF;
    border-width: 3px;
}

.primary-cta-btn:active {
    scale: 0.99 0.99;
}

/* Clean flat editorial secondary rows without decorative left stripes */
.nav-row-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    width: 100%;
    height: 52px;
    font-size: 18px;
    letter-spacing: 0.25px;
    color: #CDD6F4;
    background-color: transparent;
    border-width: 2px;
    border-color: transparent;
    border-radius: 3px;
    padding: 0 18px;
    margin-bottom: 6px;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-cubic;
}

.nav-row-btn:hover {
    background-color: #313244;
    border-color: #6C7086;
    color: #CDD6F4;
}

.nav-row-btn:focus {
    background-color: #313244;
    border-color: #F9E2AF;
    color: #CDD6F4;
}

.nav-row-btn:active {
    background-color: #45475A;
}

.nav-divider {
    width: 100%;
    height: 1px;
    background-color: #313244;
    margin-top: 10px;
    margin-bottom: 12px;
}

.nav-row-btn--quit {
    color: #A6ADC8;
    height: 48px;
    font-size: 17px;
    margin-bottom: 0;
}

.nav-row-btn--quit:hover {
    background-color: #313244;
    border-color: #F38BA8;
    color: #F38BA8;
}

.nav-row-btn--quit:focus {
    background-color: #313244;
    border-color: #F9E2AF;
    color: #F38BA8;
}

.rail-footer {
    flex-direction: column;
    align-items: flex-start;
    border-top-width: 1px;
    border-top-color: #313244;
    padding-top: 18px;
}

.footer-progress {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    margin-bottom: 6px;
}

.footer-hint {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 14px;
    color: #A6ADC8;
    letter-spacing: 0.2px;
    -unity-text-align: middle-left;
}

.footer-hint--center {
    -unity-text-align: middle-center;
}

/* Chapter & Chamber Index View */
.ribbon-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: space-between;
    background-color: rgba(17, 17, 27, 0.78);
    padding: 32px 44px 32px 44px;
    transition-property: opacity;
    transition-duration: 0.20s;
}

.ribbon-view--hidden {
    opacity: 0;
    display: none;
}

.ribbon-view--fading {
    opacity: 0;
}

.ribbon-topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.topbar-left {
    flex-direction: row;
    align-items: center;
}

.topbar-progress {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 16px;
    color: #BAC2DE;
    margin-left: 18px;
}

.topbar-actions {
    flex-direction: row;
    align-items: center;
}

.top-action-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    height: 44px;
    font-size: 15px;
    color: #CDD6F4;
    background-color: #181825;
    border-color: #6C7086;
    border-width: 1px;
    border-radius: 3px;
    padding: 0 18px;
    margin-left: 10px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
}

.topbar-left .top-action-btn {
    margin-left: 0;
}

.top-action-btn:hover {
    background-color: #313244;
    border-color: #74C7EC;
}

.top-action-btn:focus {
    background-color: #313244;
    border-color: #F9E2AF;
    border-width: 2px;
}

.top-action-btn--on {
    border-color: #A6E3A1;
    color: #A6E3A1;
}

.ribbon-viewport {
    flex-grow: 1;
    justify-content: center;
    overflow: hidden;
    position: relative;
}

.ribbon-track {
    flex-direction: row;
    align-items: center;
    position: absolute;
    top: 50%;
    margin-top: -108px;
    height: 216px;
}

.chapter-cluster {
    flex-direction: row;
    align-items: center;
    height: 216px;
}

.chapter-node-card {
    width: 166px;
    height: 178px;
    background-color: #181825;
    border-color: #6C7086;
    border-width: 1px;
    border-top-width: 4px;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    padding: 14px 12px;
    margin-right: 16px;
}

.chapter-node-card--reached {
    background-color: #1E1E2E;
    border-color: #7F849C;
}

.chapter-sector-pill {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 12px;
    color: #BAC2DE;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.chapter-node-num {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 42px;
    color: #CDD6F4;
    margin-bottom: 2px;
}

.chapter-node-theme {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #BAC2DE;
    margin-bottom: 10px;
}

.chapter-node-bar-bg {
    width: 106px;
    height: 6px;
    border-radius: 3px;
    background-color: #313244;
    position: relative;
}

.chapter-node-bar-fill {
    height: 6px;
    border-radius: 3px;
    background-color: #74C7EC;
}

.segment-rail {
    width: 420px;
    height: 160px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    position: relative;
}

.segment-line-bg {
    position: absolute;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 2px;
    background-color: #45475A;
}

.segment-line-fill {
    position: absolute;
    left: 0;
    height: 4px;
    border-radius: 2px;
    background-color: #74C7EC;
}

.level-dot-wrap {
    width: 88px;
    height: 152px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.level-dot-badge {
    position: absolute;
    top: 2px;
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 11px;
    color: #11111B;
    background-color: #74C7EC;
    border-radius: 2px;
    padding: 2px 7px;
}

.level-dot-code {
    position: absolute;
    top: 26px;
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 16px;
    color: #CDD6F4;
}

.level-dot-stars {
    position: absolute;
    bottom: 12px;
    font-size: 16px;
    color: #F9E2AF;
    letter-spacing: 2px;
}

.level-dot-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: #313244;
    border-color: #7F849C;
    border-width: 2px;
    padding: 0;
    margin: 0;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.14s;
}

.level-dot-btn--unlocked {
    background-color: #89B4FA;
    border-color: #CDD6F4;
}

.level-dot-btn--cleared {
    background-color: #A6E3A1;
    border-color: #CDD6F4;
}

.level-dot-btn--current {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: #74C7EC;
    border-color: #F9E2AF;
    border-width: 3px;
}

.level-dot-btn--unlocked:hover,
.level-dot-btn--cleared:hover,
.level-dot-btn--current:hover {
    scale: 1.12 1.12;
    border-color: #F9E2AF;
}

.level-dot-btn:focus {
    scale: 1.14 1.14;
    border-color: #F9E2AF;
    border-width: 3px;
}

.level-dot-btn:active {
    scale: 0.96 0.96;
}

.chapter-node-card--showcase {
    background-color: #1E1E2E;
    border-color: #94E2D5;
    border-top-width: 4px;
    border-top-color: #94E2D5;
}

.showcase-launch-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    height: 38px;
    font-size: 14px;
    color: #11111B;
    background-color: #94E2D5;
    border-width: 2px;
    border-color: #94E2D5;
    border-radius: 3px;
    padding: 0 14px;
    margin-top: 6px;
}

.showcase-launch-btn:hover {
    background-color: #89DCEB;
    border-color: #89DCEB;
}

.showcase-launch-btn:focus {
    background-color: #89DCEB;
    border-color: #F9E2AF;
}

.ribbon-footer {
    align-items: center;
}

.chamber-preview-card {
    min-width: 720px;
    max-width: 880px;
    flex-direction: row;
    align-items: center;
    background-color: #181825;
    border-color: #6C7086;
    border-width: 1px;
    border-radius: 3px;
    margin-bottom: 14px;
    padding: 16px 22px;
}

.preview-content {
    flex-grow: 1;
    flex-direction: column;
    padding-right: 20px;
}

.preview-chapter {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 14px;
    color: #94E2D5;
    margin-bottom: 4px;
}

.preview-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 24px;
    color: #CDD6F4;
    margin-bottom: 4px;
}

.preview-status {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 15px;
    color: #BAC2DE;
}

.preview-launch-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    height: 48px;
    min-width: 144px;
    padding: 0 24px;
    font-size: 17px;
    color: #11111B;
    background-color: #74C7EC;
    border-width: 2px;
    border-color: #74C7EC;
    border-radius: 3px;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
}

.preview-launch-btn:hover {
    background-color: #89DCEB;
    border-color: #89DCEB;
}

.preview-launch-btn:focus {
    background-color: #89DCEB;
    border-color: #F9E2AF;
    border-width: 3px;
}

/* Settings Modal */
.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(17, 17, 27, 0.84);
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.settings-overlay--hidden {
    display: none;
    opacity: 0;
}

.settings-card {
    width: 560px;
    background-color: #1E1E2E;
    border-color: #7F849C;
    border-width: 1px;
    border-top-width: 4px;
    border-top-color: #74C7EC;
    border-radius: 3px;
    padding: 32px 34px 28px 34px;
}

.settings-title {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktBold.asset");
    font-size: 28px;
    color: #CDD6F4;
    margin-bottom: 6px;
}

.settings-subtitle {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktRegular.asset");
    font-size: 15px;
    color: #BAC2DE;
    margin-bottom: 24px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #181825;
    border-color: #45475A;
    border-width: 1px;
    border-radius: 3px;
    padding: 14px 18px;
    margin-bottom: 12px;
}

.setting-label {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 16px;
    color: #CDD6F4;
    min-width: 210px;
}

.setting-slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 14px;
}

.setting-slider .unity-base-slider__tracker {
    background-color: #6C7086;
    height: 6px;
    border-radius: 3px;
}

.setting-slider .unity-base-slider__dragger {
    background-color: #74C7EC;
    border-color: #CDD6F4;
    border-width: 2px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-top: -6px;
}

.setting-slider:focus .unity-base-slider__dragger {
    background-color: #89DCEB;
    border-color: #F9E2AF;
}

.setting-value {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    min-width: 56px;
    -unity-text-align: middle-right;
}

.setting-language-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktMedium.asset");
    font-size: 15px;
    color: #94E2D5;
    background-color: #313244;
    border-color: #45475A;
    border-width: 1px;
    border-radius: 3px;
    padding: 6px 14px;
    min-width: 120px;
}

.setting-language-btn:hover {
    border-color: #89DCEB;
}

.setting-language-btn:focus {
    border-color: #F9E2AF;
}

.setting-toggle {
    margin: 0;
}

.setting-toggle .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    background-color: #313244;
    border-color: #7F849C;
    border-width: 2px;
    border-radius: 3px;
    -unity-background-image-tint-color: #11111B;
}

.setting-toggle:focus .unity-toggle__checkmark {
    border-color: #F9E2AF;
}

.setting-toggle:checked .unity-toggle__checkmark {
    background-color: #74C7EC;
    border-color: #89B4FA;
    -unity-background-image-tint-color: #11111B;
}

.settings-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 18px;
}

.modal-btn {
    -unity-font-definition: url("/Assets/UI/Fonts/Font_AktSemiBold.asset");
    flex-grow: 1;
    height: 48px;
    font-size: 16px;
    border-radius: 3px;
    border-width: 2px;
    margin-left: 6px;
    margin-right: 6px;
    padding: 0 18px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
}

.modal-btn--primary {
    background-color: #74C7EC;
    border-color: #74C7EC;
    color: #11111B;
}

.modal-btn--primary:hover {
    background-color: #89DCEB;
    border-color: #89DCEB;
}

.modal-btn--primary:focus {
    background-color: #89DCEB;
    border-color: #F9E2AF;
    border-width: 3px;
}

.modal-btn--danger {
    background-color: #313244;
    border-color: #7F849C;
    color: #CDD6F4;
}

.modal-btn--danger:hover {
    background-color: #181825;
    border-color: #F38BA8;
    color: #F38BA8;
}

.modal-btn--danger:focus {
    background-color: #181825;
    border-color: #F9E2AF;
    border-width: 3px;
    color: #F38BA8;
}

/* Reduced motion override toggled by SimulationSettings.ReduceMotion */
.menu-root--reduce-motion .title-view,
.menu-root--reduce-motion .ribbon-view,
.menu-root--reduce-motion .settings-overlay,
.menu-root--reduce-motion .primary-cta-btn,
.menu-root--reduce-motion .nav-row-btn,
.menu-root--reduce-motion .top-action-btn,
.menu-root--reduce-motion .level-dot-btn,
.menu-root--reduce-motion .preview-launch-btn,
.menu-root--reduce-motion .modal-btn {
    transition-duration: 0s;
}
